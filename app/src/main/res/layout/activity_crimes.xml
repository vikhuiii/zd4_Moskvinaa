<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Crimes">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:id="@+id/crime1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white" android:layout_margin="4dp" android:padding="16dp" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crime_1" android:textSize="16sp" android:textColor="@color/black" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_1" android:textSize="12sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/crime2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white" android:layout_margin="4dp" android:padding="16dp" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crime_2" android:textSize="16sp" android:textColor="@color/black" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_2" android:textSize="12sp"  android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/crime3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white" android:layout_margin="4dp" android:padding="16dp" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crime_3" android:textSize="16sp" android:textColor="@color/black" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_3" android:textSize="12sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/crime4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white" android:layout_margin="4dp" android:padding="16dp" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crime_4" android:textSize="16sp" android:textColor="@color/black" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_4" android:textSize="12sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/crime5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white" android:layout_margin="4dp" android:padding="16dp" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crime_5" android:textSize="16sp" android:textColor="@color/black" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/date_5" android:textSize="12sp" android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>